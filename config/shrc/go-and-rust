GOPATH=${HOME}/go

if [ -f "$HOME/.cargo/env" ]
then
    source "$HOME/.cargo/env"
fi

if test -d ${GOPATH}/bin
then
    PATH=${PATH}:${GOPATH}/bin
fi

if test -d ${HOME}/.cargo/bin
then
    PATH=${PATH}:${HOME}/.cargo/bin
fi

export GOPATH PATH
