new_dirs_path="
    ${HOME}/.local/bin
    /home/miguel/.opencode/bin
    $HOME/.local/share/qgenie-cli/opencode-cli/bin
    $HOME/.local/share/qgenie-cli/claude-code/bin
    "

for d in $new_dirs_path
do
    if test -d "$d"
    then
        if echo "$PATH" | grep --quiet --invert-match "$d"
        then
            PATH="$PATH":"$d"
        fi
    fi
done

if [ "x${DISPLAY}" != "x" -a ! -f $HOME/.cache/usevim ]; then
    EDITOR="gvim -f"
    VISUAL="gvim -f"
fi

if [ "${XDG_SESSION_TYPE}" = "wayland" ]
then
    export GVIM_ENABLE_WAYLAND=1
fi

export PATH EDITOR VISUAL BAT_PAGER
